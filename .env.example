# RushVoice v2.5 environment variables template
# Copy actual values to .env (never commit .env)
# L058 fix: clipboard via OleSetClipboard + SendInput(Ctrl+V) for 96% reduction
# L066: IME user dictionary auto-sync is permanently forbidden
# L089: window force restore on record start is forbidden

# ---- OpenAI (Whisper / Realtime API) ----
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXX

# ---- Groq (Whisper turbo primary) ----
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXX

# ---- OpenAI Realtime endpoint ----
# L061: transcription-only is the legacy endpoint
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
OPENAI_REALTIME_MODEL=gpt-realtime-whisper

# ---- v1 adopted method (hedged) ----
# trigger sec hedged: Groq first -> wait trigger sec -> OpenAI fallback if exceeded
# Phase 1 = 3.0 (same as v1) / Phase 3 = 0.2 (shorter)
RUSHVOICE_HEDGED_TRIGGER_SEC=3.0

# ---- Local settings ----
RUSHVOICE_LOG_LEVEL=info
RUSHVOICE_CONFIG_VERSION=1
